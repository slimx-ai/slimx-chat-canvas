# Echo mode is the safest first local test.
MODEL_BACKEND=echo

# To use the local PyTorch model through SlimX:
# MODEL_BACKEND=slimx
# LLM_PROVIDER=toaster
# LLM_MODEL=babygpt-152m

PORT=8080
STATIC_DIR=static
LOG_LEVEL=INFO

# Toaster model paths. The large model file is intentionally not included in git/zip.
TOASTER_MODEL_DIR=model/babyGPT
TOASTER_CONFIG_PATH=model/babyGPT/babyGPT_152M_config
TOASTER_CHECKPOINT_PATH=model/babyGPT/babyGPT_152M
TOASTER_DEVICE=auto

# Generation controls
LLM_MAX_TOKENS=128
LLM_TEMPERATURE=0.8
MAX_HISTORY_MESSAGES=8
TOASTER_TOP_K=35
TOASTER_DO_SAMPLE=1
TOASTER_RETURN_FULL_TEXT=0
TOASTER_STOP_ON_EOT=1
